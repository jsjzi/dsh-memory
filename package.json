{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "全局记忆插件：把对话提炼为结构化记忆（结论/决定/待办），SQLite FTS5 中文检索，Top-K 注入。基于 mem.py 双层记忆系统。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "mem.py",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "memory",
    "记忆",
    "plugin"
  ],
  "license": "MIT"
}
